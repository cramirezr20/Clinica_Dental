{
    "name":  "dentalgest",
    "version":  "1.0.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "concurrently -k \"node --watch server/index.js development\" \"vite --host 127.0.0.1 --port 5180\"",
                    "build":  "vite build",
                    "start":  "node server/index.js production",
                    "start:dev":  "node server/index.js development",
                    "start:staging":  "node server/index.js staging",
                    "start:test":  "node server/index.js test",
                    "db:setup":  "node scripts/setup-db.js",
                    "test":  "node --test --test-concurrency=1 tests/*.test.js",
                    "reminders":  "node server/reminders-cli.js development",
                    "test:browser":  "node tests/browser.mjs",
                    "backup":  "node scripts/backup.js",
                    "docs:uml":  "node scripts/generate-uml.js"
                },
    "dependencies":  {
                         "bcryptjs":  "^3.0.2",
                         "dotenv":  "^16.5.0",
                         "express":  "^5.1.0",
                         "express-rate-limit":  "^7.5.0",
                         "helmet":  "^8.1.0",
                         "jsonwebtoken":  "^9.0.2",
                         "lucide-react":  "^0.468.0",
                         "nodemailer":  "^10.2.1",
                         "pg":  "^8.16.0",
                         "react":  "^19.1.0",
                         "react-dom":  "^19.1.0",
                         "zod":  "^4.6.7"
                     },
    "devDependencies":  {
                            "@playwright/test":  "^1.51.0",
                            "@vitejs/plugin-react":  "^4.5.0",
                            "concurrently":  "^9.1.2",
                            "vite":  "^6.3.5"
                        }
}